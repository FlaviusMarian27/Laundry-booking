# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (used only by core-service)
POSTGRES_DB=laundry
POSTGRES_USER=laundry
POSTGRES_PASSWORD=change-me

# Kafka
# from your machine: localhost:9092 | from another container: kafka:19092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# LLM provider key for the agent
LLM_API_KEY=
